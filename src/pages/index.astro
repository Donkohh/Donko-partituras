---
import Base from '../layouts/Base.astro';
import { ListaPartituras } from '../components/public/ListaPartituras';
---

<Base title="Donko Partituras — Repertorio General">
  {/* Hero con pentagrama sutil y resplandor */}
  <section class="relative overflow-hidden staff-lines py-12 sm:py-20 border-b border-white/5">
    {/* Resplandor ambiental de acento */}
    <div
      aria-hidden="true"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[320px] bg-gradient-to-tr from-[#f5b942]/10 via-[#8b5cf6]/10 to-transparent blur-3xl pointer-events-none rounded-full"
    ></div>

    <div class="max-w-4xl mx-auto px-4 text-center relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs text-[#f5b942] mb-5 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#f5b942] animate-pulse"></span>
        Repertorio General
      </div>

      <h1 class="text-4xl sm:text-6xl font-['Instrument_Serif'] italic tracking-wide text-white mb-3">
        Donko Partituras
      </h1>

      <p class="text-gray-400 text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        Consulta, busca y abre partituras directamente en tu navegador con visor nativo.
      </p>
    </div>
  </section>

  {/* Isla interactiva de React con buscador, filtros y repertorio */}
  <div class="py-8">
    <ListaPartituras client:load />
  </div>
</Base>
