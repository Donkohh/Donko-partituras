---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Página no encontrada | Donko Partituras" noindex={true}>
  <div class="flex-1 flex items-center justify-center py-20 px-4 relative overflow-hidden staff-lines">
    <div
      aria-hidden="true"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[400px] h-[300px] bg-[#8b5cf6]/10 blur-3xl rounded-full pointer-events-none"
    ></div>

    <div class="max-w-md w-full text-center relative z-10 bg-[#14141c] border border-white/10 rounded-2xl p-8 shadow-2xl">
      <div class="w-16 h-16 rounded-2xl bg-[#0a0a0f] border border-white/10 flex items-center justify-center text-3xl mx-auto mb-5 text-[#f5b942]">
        🎼
      </div>

      <span class="text-xs uppercase font-semibold tracking-widest text-[#f5b942] block mb-2">
        Error 404
      </span>

      <h1 class="text-3xl font-['Instrument_Serif'] italic text-white mb-3">
        Compás no encontrado
      </h1>

      <p class="text-xs text-gray-400 mb-6 leading-relaxed">
        La página que buscas no existe o fue movida a otra ubicación.
      </p>

      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-[#f5b942] to-[#e0a331] text-[#0a0a0f] font-semibold text-xs tracking-wide hover:opacity-90 transition-opacity focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f5b942]"
      >
        <span>Volver al Repertorio</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</Base>
