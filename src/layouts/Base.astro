---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'Donko Partituras — Repertorio y Hojas de Música',
  description = 'Repertorio general de partituras en PDF. Consulta, busca y descarga partituras fácilmente.',
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body class="bg-[#0a0a0f] text-gray-100 min-h-screen flex flex-col selection:bg-[#f5b942]/30 selection:text-white">
    <!-- Header -->
    <header class="border-b border-white/5 bg-[#0a0a0f]/80 backdrop-blur-md sticky top-0 z-40 transition-colors">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#f5b942] rounded-lg p-1">
          <div class="w-8 h-8 rounded-lg bg-[#14141c] border border-white/10 flex items-center justify-center text-[#f5b942] group-hover:border-[#f5b942]/40 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="font-['Instrument_Serif'] italic text-2xl text-transparent bg-clip-text bg-gradient-to-r from-[#f5b942] to-[#e0a331]">
              Donko
            </span>
            <span class="font-['Sora'] font-semibold text-sm tracking-wider uppercase text-white/90">
              Partituras
            </span>
          </div>
        </a>

        <!-- Navegación pública -->
        <nav class="flex items-center gap-1 sm:gap-2">
          <a
            href="/"
            class:list={[
              'px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all',
              currentPath === '/'
                ? 'bg-white/10 text-[#f5b942]'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            Repertorio
          </a>
          <a
            href="/carpetas"
            class:list={[
              'px-3.5 py-1.5 rounded-lg text-sm font-medium transition-all',
              currentPath.startsWith('/carpetas')
                ? 'bg-white/10 text-[#f5b942]'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            Carpetas
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8 text-center text-xs text-gray-500">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>Donko Partituras &copy; {new Date().getFullYear()} — Todos los derechos reservados</p>
        <p class="text-gray-600">Repertorio musical público</p>
      </div>
    </footer>
  </body>
</html>
